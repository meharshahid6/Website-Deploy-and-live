{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "website-deploy-and-live",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "launchdock",
      "database_id": "63de38bc-07c9-4024-8e05-68a0f88844eb",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "APP_ORIGIN": "https://website-deploy-and-live.agentflowcloud.workers.dev",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "OWNER_EMAIL": "",
    "LOCAL_DEV": "false",
    "DASHBOARD_KEY": "Shahid@LaunchDock2026",
  },
  "observability": { "enabled": false },
}
